# ---------- marble_jar_core ----------
DATABASE_URL=postgres://marblejar:marblejar@localhost:5432/marblejar?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDPANDA_BROKERS=localhost:9092
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Must be at least 32 bytes outside DEV_MODE.
JWT_SIGNING_KEY=replace-me-with-a-long-random-string-32b+
HMAC_DISPATCH_SECRET=replace-me-with-a-random-secret

# Arize Phoenix (trace lineage).
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_API_KEY=

# OBO / OAuth2 token exchange (Ory Hydra, Kratos or Auth0).
OAUTH_ISSUER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=

# ---------- dispatch worker ----------
CORE_API_BASE_URL=http://localhost:8080
# An mj_ API key with dispatch:write scope, used to report results back.
CORE_SERVICE_TOKEN=
DISPATCH_WORKER_CONCURRENCY=4
WORKER_PORT=8081

# Per-integration OAuth apps.
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
ENTRA_ID_TENANT_ID=
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=

# ---------- mcp bridge ----------
MCP_SERVER_PORT=8090

# ---------- web ----------
VITE_API_BASE_URL=http://localhost:8080
