# ---------- marble_jar_core ----------
DATABASE_URL=postgres://marblejar:marblejar@localhost:5432/marblejar?sslmode=disable
REDIS_URL=redis://localhost:6379/0
REDPANDA_BROKERS=localhost:9092
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Must be at least 32 bytes outside DEV_MODE.
JWT_SIGNING_KEY=replace-me-with-a-long-random-string-32b+
HMAC_DISPATCH_SECRET=replace-me-with-a-random-secret

# Arize Phoenix (trace lineage).
PHOENIX_BASE_URL=http://localhost:6006
PHOENIX_API_KEY=

# OBO / OAuth2 token exchange (Ory Hydra, Kratos or Auth0).
# With docker compose, Hydra runs at http://localhost:4444 (admin :4445).
OAUTH_ISSUER_URL=http://localhost:4444
OAUTH_CLIENT_ID=marble-jar
OAUTH_CLIENT_SECRET=replace-me-hydra-client-secret

# OAuth connect flow: where the provider redirects back (this API) and where
# the user lands afterwards (the web app). Google sign-in uses the same pair:
# its redirect URI is PUBLIC_API_BASE_URL + /v1/auth/google/callback.
PUBLIC_API_BASE_URL=http://localhost:8080
WEB_APP_URL=http://localhost:5173

# ---------- sign in with Google (dashboard humans) ----------
# Google Cloud console → APIs & Services → Credentials → Create Credentials →
# OAuth client ID → type "Web application". No password accounts exist any more,
# so without these two the dashboard cannot sign anyone in (agents still work
# with mj_ API keys).
#
#   Authorized redirect URIs (required) : http://localhost:8080/v1/auth/google/callback
#   Authorized JavaScript origins — only needed if you later embed Google's own
#   sign-in button script; this app's redirect flow does not ask for it:
#     http://localhost:5173
#
# The redirect URI must match PUBLIC_API_BASE_URL exactly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional: restrict sign-in to your Workspace domains (comma-separated).
# Leave empty to allow any Google account with a verified email.
GOOGLE_OAUTH_ALLOWED_DOMAINS=

# Hydra container itself (docker compose).
HYDRA_SECRETS_SYSTEM=replace-me-32-byte-hydra-system-secret

# ---------- dispatch worker ----------
CORE_API_BASE_URL=http://localhost:8080
# An mj_ API key with dispatch:write scope, used to report results back.
CORE_SERVICE_TOKEN=
DISPATCH_WORKER_CONCURRENCY=4
WORKER_PORT=8081

# Per-integration OAuth apps. Without these the matching Connect button
# returns 501 with a hint. Slack app: api.slack.com/apps → OAuth & Permissions
# → user token scope chat:write, redirect URL
#   http://localhost:8080/v1/integrations/slack/callback
ATLASSIAN_OAUTH_CLIENT_ID=
ATLASSIAN_OAUTH_CLIENT_SECRET=
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CLIENT_SECRET=
ENTRA_ID_TENANT_ID=
ENTRA_ID_CLIENT_ID=
ENTRA_ID_CLIENT_SECRET=

# ---------- mcp bridge ----------
MCP_SERVER_PORT=8090

# ---------- web ----------
VITE_API_BASE_URL=http://localhost:8080
